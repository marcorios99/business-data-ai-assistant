# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q8_0

# Reference SQL Server database (local development / Windows Authentication).
# Instance name, ODBC driver, and TLS policy can vary by environment.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=WideWorldImporters
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=false
# Development only; do not use this as a production TLS policy.
DB_TRUST_SERVER_CERTIFICATE=true

# Application
APP_ENV=development
